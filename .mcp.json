{
  "mcpServers": {
    "neo4j": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "neo4j_mcp_server"],
      "env": {
        "NEO4J_URI": "${REALYTICA_NEO4J_URL:-bolt://localhost:7687}",
        "NEO4J_USERNAME": "${REALYTICA_NEO4J_USER:-neo4j}",
        "NEO4J_PASSWORD": "${REALYTICA_NEO4J_PASSWORD:-realytica-dev}",
        "NEO4J_DATABASE": "${REALYTICA_NEO4J_DATABASE:-neo4j}",
        "NEO4J_READ_ONLY": "${REALYTICA_NEO4J_MCP_READ_ONLY:-true}",
        "NEO4J_TELEMETRY": "false"
      }
    }
  }
}
