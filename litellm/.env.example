# Keys for LiteLLM — the proxy holds every vendor credential so Realytica
# holds none. Copy to litellm/.env and fill in what you use.

# Master key. Admin access to the proxy and its UI. Must start with "sk-".
LITELLM_MASTER_KEY=sk-change-me

# Signs the virtual keys the proxy issues. Any long random string.
LITELLM_SALT_KEY=change-me-too

# Vendor keys. Only the ones referenced by litellm/config.yaml are needed.
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
