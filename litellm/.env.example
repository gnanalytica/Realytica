# LiteLLM's own environment.
#
# The proxy holds every vendor credential so Realytica holds none: it gets one
# virtual key, issued here, and never sees a vendor's. Copy this to
# `litellm/.env` (gitignored) and fill in what you use.

# --- The proxy itself ------------------------------------------------------

# Admin access to the proxy and its API. Must start with "sk-".
LITELLM_MASTER_KEY=sk-change-me

# Signs the virtual keys the proxy issues. Any long random string.
LITELLM_SALT_KEY=change-me-too

# --- The admin UI at http://localhost:4000/ui ------------------------------
#
# Where you add models and their keys without touching a file, mint virtual
# keys for Realytica, set per-key monthly budgets and rate limits, and watch
# spend per key, per model and per day. Both are required to log in.
UI_USERNAME=admin
UI_PASSWORD=change-me-as-well

# --- Vendor keys -----------------------------------------------------------
#
# Only the ones a `litellm/config.yaml` entry actually references. Anything
# added through the UI instead is stored in the database and needs nothing
# here. LiteLLM speaks to ~150 providers; these are the ones worth naming.

ANTHROPIC_API_KEY=

# GEMINI_API_KEY=            # Google AI Studio — has a free tier
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=          # Kimi
# HUGGINGFACE_API_KEY=       # Inference Providers / a dedicated endpoint
# OPENAI_API_KEY=
# GROQ_API_KEY=
# TOGETHERAI_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=        # a gateway behind the gateway, if you want one
